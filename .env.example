# ========================================
# 寵物日誌 Pet Journal - 環境變數範本
# ========================================
# 複製此檔案為 .env，填入實際值後使用
# 注意：.env 已加入 .gitignore，請勿將真實金鑰推上 GitHub

# Supabase 設定
# 從 Supabase Dashboard → Project Settings → API 取得
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# LINE Bot 設定
# 從 LINE Developers Console → Messaging API Channel 取得
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here

# Cron Job 驗證密鑰
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 設定到 Vercel → Settings → Environment Variables
CRON_SECRET=your_cron_secret_here
